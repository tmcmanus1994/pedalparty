# Copy to .env.local for local dev, and set the same keys in Vercel →
# Project → Settings → Environment Variables.
#
# With none of these set the site still builds and runs: it renders the
# example ride from src/lib/ride.ts and /admin tells you what's missing.

# --- Site ---------------------------------------------------------------
# Canonical origin, used for metadata / OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://pedalpartylr.com

# --- /admin -------------------------------------------------------------
# The password for the ride console at /admin. Any long random string.
# Unset, the console shows a "not configured" notice and nothing else.
ADMIN_PASSWORD=

# --- Ride storage -------------------------------------------------------
# Created for you: Vercel → Storage → Create → Blob. Connecting the store to
# the project injects this automatically; you should never paste it by hand.
# Unset, publishing is disabled and the site shows the example ride.
BLOB_READ_WRITE_TOKEN=

# --- Writing rides from outside the site ---------------------------------
# Lets anything outside the app push the site to re-read the ride store.
# /admin does this directly on publish, so this is only for external callers.
REVALIDATE_SECRET=

# Lets an outside automation POST a finished ride to /api/ride — as a draft
# for review, or published outright. Any long random string. Unset, that
# endpoint refuses everything. See the README for the JSON shape.
RIDE_SECRET=

# --- Contact form delivery (pick ONE) ------------------------------------
# 1) Resend — emails pedalpartylr@gmail.com directly.
RESEND_API_KEY=
# Must be a domain verified in Resend once DNS is set up.
CONTACT_FROM="Pedal Party <hello@pedalpartylr.com>"

# 2) Or a webhook — Zapier / Make / Formspree endpoint.
CONTACT_WEBHOOK_URL=
