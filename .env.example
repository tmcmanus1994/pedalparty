# Copy to .env.local for local dev, and set the same keys in Vercel →
# Project → Settings → Environment Variables. Every one of these is optional:
# with none set the site builds and runs against safe fallbacks.

# --- Site ---------------------------------------------------------------
# Canonical origin, used for metadata / OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://pedalpartylr.com

# --- Next Ride data (Google Sheet the Cowork automation already writes) ---
# In the sheet: File → Share → Publish to web → select the ride tab →
# Comma-separated values (.csv) → Publish. Paste that URL here.
# Unset = the site renders the example ride from src/lib/ride.ts.
RIDE_SHEET_CSV_URL=

# --- Contact form delivery (pick ONE) ------------------------------------
# 1) Resend — emails pedalpartylr@gmail.com directly.
RESEND_API_KEY=
# Must be a domain verified in Resend once DNS is set up.
CONTACT_FROM="Pedal Party <hello@pedalpartylr.com>"

# 2) Or a webhook — Zapier / Make / Formspree / Apps Script endpoint.
CONTACT_WEBHOOK_URL=
